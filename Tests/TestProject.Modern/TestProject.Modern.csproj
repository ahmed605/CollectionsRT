  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CollectionsRT\CollectionsRT.csproj" />
    <ProjectReference Include="..\TestComponent\TestComponent.vcxproj" />
  </ItemGroup>

</Project>
